{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "cpu", "memory", "tray"],

  "hyprland/workspaces": {
    "format": "",
    "persistent-workspaces": { "*": 4 },
    "on-click": "activate",
    "all-outputs": true
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 32,
    "separate-outputs": true
  },

  "clock": {
    "interval": 30,
    "format": "<b>{0:%H:%M}</b>   <span size='small' color='#8a8a8a'>{0:%a %d %b}</span>",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#f2f2f2'><b>{}</b></span>",
        "days": "<span color='#b0b0b0'>{}</span>",
        "weekdays": "<span color='#7a7a7a'>{}</span>",
        "today": "<span color='#ffffff'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "pulseaudio": {
    "format": "<span color='#8a8a8a'>\uf028</span>  {volume}%",
    "format-muted": "<span color='#8a8a8a'>\uf026</span>  muted",
    "tooltip-format": "{desc}",
    "on-click": "pavucontrol",
    "scroll-step": 5
  },

  "network": {
    "interval": 5,
    "format-wifi": "<span color='#8a8a8a'>\uf1eb</span>  {signalStrength}%",
    "format-ethernet": "<span color='#8a8a8a'>\udb80\ude00</span>  wired",
    "format-disconnected": "<span color='#8a8a8a'>\uf071</span>  off",
    "tooltip-format": "{ifname}  {ipaddr}",
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ifname}  {ipaddr}",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected"
  },

  "cpu": {
    "interval": 3,
    "format": "<span color='#8a8a8a'>\uf2db</span>  {usage:2}%"
  },

  "memory": {
    "interval": 5,
    "format": "<span color='#8a8a8a'>\udb80\udf5b</span>  {percentage:2}%",
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  }
}
