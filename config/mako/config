# Generated by Matugen from ~/.config/matugen/templates/glass-mako.conf
# Edit the template, not this file.

# --- layout -----------------------------------------------------------
font=JetBrainsMono Nerd Font 10
anchor=top-right
layer=overlay
width=360
height=150
outer-margin=14
margin=6
padding=14,16
max-visible=5
sort=-time

# --- shape / colour ---------------------------------------------------
border-size=1
border-radius=14
background-color=#0c0e13d1
text-color=#e2e2e9
border-color=#adc6ff59
progress-color=over #adc6ffcc

# --- content ----------------------------------------------------------
markup=1
actions=1
icons=1
max-icon-size=40
icon-location=left
history=1
max-history=50
format=<b>%s</b>\n<span alpha="75%">%b</span>

# --- timeouts (ms) ----------------------------------------------------
default-timeout=6000
ignore-timeout=0

[urgency=low]
default-timeout=3000
text-color=#c4c6d0
border-color=#44474f66
progress-color=over #8e909999

[urgency=critical]
default-timeout=0
border-size=2
border-color=#ffb4abe6
progress-color=over #ffb4abcc
